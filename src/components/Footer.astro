---
import logo from "../assets/logo.png";

import { NAV_LINKS } from "../lib/values";
---

<footer class="bg-primary py-8 text-white">
  <div class="container mx-auto flex justify-between gap-24 px-8">
    <div class="flex flex-col gap-4">
      <nav>
        <ul class="flex gap-6 text-lg">
          {
            NAV_LINKS.map((v, i) => (
              <li>
                <a href={v.href}>{v.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="text-md">
        ⓒ Sega ⓒ Atlus ⓒ Nintendo. All Rights Reserved.<br />
        Some assets are the intellectual property of Sega, Atlus, Nintendo and/or
        their respective copyright holders. This project does not, and will never,
        go up for sale. Nothing monetary is being sought from it.
      </p>

      <p>Icons by <a href="https://icons8.com/" class="hyperlink">Icons8</a></p>
    </div>

    <img src={logo.src} class="h-15 w-auto self-center py-2" />
  </div>
</footer>
