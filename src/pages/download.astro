---
import Layout from "../layouts/Layout.astro";
import Button from "../components/react/Button.tsx";
import dots from "../assets/Dots.svg";
import glass from "../assets/glass.png";
import makoto from "../assets/makoto-standing.png";
---
<Layout>
  <main>
    <section id="index" class="relative min-h-screen w-full">
      <div
        class="pointer-events-none absolute inset-0 select-none"
      >
      <div class="pointer-events-none absolute inset-x-0 top-0 h-[calc(100%+300px)] bg-[#E6F0FA]"
      aria-hidden="true"> </div>
        <div
          class="absolute inset-0 translate-y-12 bg-repeat h-[120%] lg:left-[40%]"
          style={`background-image: url('${dots.src}'); background-size: auto;`}
        >
        </div>

        <div
          class="absolute top-[64%] right-[2.1%] h-[1100px] w-[550px] max-w-none translate-x-[6%] -translate-y-1/2 select-none lg:block"
          aria-hidden="true"
        >
          <img
            src={makoto.src}
            alt=""
            aria-hidden="false"
            class="h-full w-full object-contain"
          />
        </div>
      </div>

      <div
        class="p3d-container relative z-10 grid w-full grid-cols-1 pt-16 lg:grid-cols-12"
      >
        <div
          class="relative flex flex-col items-center justify-start pt-6 pr-0 pb-4 text-center sm:pt-10 sm:pb-6 lg:col-span-25 lg:items-start lg:pt-28 lg:pr-4 lg:pb-16 lg:text-left"
        >
  
          <div
            class="pointer-events-none absolute left-1/2 -z-10 block h-[860px] w-[1280px] max-w-none -translate-x-1/2 rounded-[50%] bg-[#79CEFF] select-none sm:h-[940px] sm:w-[1500px] lg:hidden"
            style="top: -450px;"
            aria-hidden="true"
          >
          </div>

          <h1
            style="-webkit-text-stroke: 1.5px #001B3D;"
            class="font-bmspace mb-3 text-[45px] leading-tight tracking-[-0.05em] text-[#001B3D] sm:text-5xl lg:mb-6 lg:text-[55px]"
          >
            Downloads
          </h1>

          <p
            class="font-noto-sans max-w-[440px] px-2 text-[19px] leading-snug font-semibold text-[#001B3D] sm:px-0 sm:text-xl lg:text-[28.1px]"
          >
            Next Minor Release (v1.2.0)
          </p>
          <p
            class="font-MgOpenCosmeticaBold max-w-[400px] px-2 text-[19px] text-[#001B3D] sm:px-0 sm:text-xl lg:text-[20px]"
          >
            August 20, 2026
          </p>
          <br />
          <br />
          <p
            class="font-noto-sans max-w-[440px] px-2 text-[19px] font-semibold text-[#001B3D] sm:px-0 sm:text-xl lg:text-[28.1px]"
          >
            Next Minor Release (v2.0.0)
          </p>
          <p
            class="font-MgOpenCosmeticaBold max-w-[400px] px-2 text-[19px] text-[#001B3D] sm:px-0 sm:text-xl lg:text-[20px]"
          >
            September, 2026
        </p>
           <section
      id="team"
      class="relative w-full scroll-mt-16 px-150 py-10 pt-10 pb-5 sm:pt-22"
    >
    <div class="w-full flex flex-col items-start justify-center gap-4 sm:gap-6 lg:gap-2">
      <div class="relative mb-4 flex justify-left right-[200px] translate-y-6">
        <Button
          as="a"
          href=""
          size="lg"
          className="w-[820px] py-5 text-4xl justify-center"
        >
          Download v1.1.0
        </Button>
      </div>

      <div class="relative flex justify-center gap-6 right-[200px] translate-y-6">
        <Button
          as="a"
          href=""
          size="lg"
          className="w-[400px] py-4 text-2xl justify-center"
        >
          Mirror 1
        </Button>
        
      <Button
          as="a"
          href=""
          size="lg"
          className="w-[400px] py-4 text-2xl justify-center"
        >
          Mirror 2
        </Button>
        </div>
        </div>
    </section>
  </div>
</div>
  </section>
          <section class ="relative z-20 mb-4 w-full bg-[#79CEFF] pb-16 translate-y-43">
            <div class="translate-x-20">
            <h2 class="font-noto-sans max-w-[440px] mb-4 px-2 pt-8 text-[19px] font-semibold text-[#001B3D] sm:px-0 sm:text-xl lg:text-[28.1px]">
              What's New?
            </h2>
              
            <p class="font-noto-sans text-[19px] font-semibold text-[#001B3D] sm:text-xl lg:text-[20px]">
              For specifics, check out our <a href="" class="text-[#0000FF] underline">documentation!</a>
            </p>
            <ul class="list-disc font-MgOpenCosmeticaBold text-[19px] px-2 text-[#001B3D] sm:text-xl lg:text-[20px]">
              <li>Replaced AI systems</li>
              <li>Retooled and rebuilt Aegis-Engine</li>
              <li>Added vertex lighting workflow support</li>
              <li>Migrated from devkitpro NDS to BlocksDS</li>
              <li>Replaced graphics rendering system</li>
              <li>Revamped controls</li>
              <li>Revamped UI for all menus</li>
              <li>Custom text engine</li>
              <li>Controllable Camera</li>
              <li>Optimized VRAM usage</li>
              <li>New dialogue busts with multiple facial expressions</li>
              <li>A World Map</li>
              <li>Custom music tracks</li>
              <li>Custom 3D models for props, enviroment, and characters</li>
            </ul>
          </div>
          </section>
           <section class ="relative z-20 mb-4 pb-16 bg-[#E6F0FA] translate-y-16">
            <div class="translate-x-20">
          <h2 class="font-noto-sans max-w-[440px] mb-4 px-2 pt-8 text-[19px] font-semibold text-[#001B3D] sm:px-0 sm:text-xl lg:text-[28.1px]">
            Legacy versions
          </h2>
          <p class="font-noto-sans text-[19px] font-semibold text-[#001B3D] sm:text-xl lg:text-[20px]">
            V1.0.1
          </p>
          <p class="font-noto-sans text-[19px] font-semibold text-[#001B3D] sm:text-xl lg:text-[20px]">
            PLACEHOLDER
            PLACEHOLDER
            PLACEHOLDER
          </p>
          <p class="font-noto-sans text-[19px] font-semibold text-[#001B3D] sm:text-xl lg:text-[20px]">
            PLACEHOLDER
            PLACEHOLDER
            PLACEHOLDER
          </p>
          <p class="font-noto-sans text-[19px] font-semibold text-[#001B3D] sm:text-xl lg:text-[20px]">
            PLACEHOLDER
            PLACEHOLDER
            PLACEHOLDER
          </p>
        
        <div class="mb-4 flex justify-left">
        <Button
          as="a"
          href=""
          size="md"
          className="w-[410px] py-5 text-4xl justify-center"
        >
          Download v1.1.0
        </Button>
      </div>

      <div class=" relative flex justify-center gap-6 right-[550px] translate-y-0.5">
        <Button
          as="a"
          href=""
          size="lg"
          className="w-[190px] py-4 text-2xl justify-center"
        >
          Mirror 1
        </Button>
      
      <div class="flex justify-center gap-6">
      <Button
          as="a"
          href=""
          size="lg"
          className="w-[190px] py-4 text-2xl justify-center"
        >
          Mirror 2
        </Button>
        </div>
        </div>
        </div>
        </section>
    </main>
</Layout>