              md:col-start-1
              md:row-start-2
              md:mt-0">
            <Button
              as="a"
              href="https://github.com/p3d-project/persona-3-dual/releases/tag/Beta"
              target="_blank"
              size="md"
              className="w-[min(310px,85vw)] justify-center py-3 text-2xl
                sm:text-3xl
                lg:w-[410px]">
