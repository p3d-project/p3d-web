---
import Layout from "../layouts/Layout.astro";
import Button from "../components/react/Button.tsx";
import dots from "../assets/Dots.svg";
import glass from "../assets/glass.png";
import makoto from "../assets/makoto_standing1.png";
import marked from "../assets/glass_marked.png";
import rect5 from "../assets/Rectangle_5.png";
import rect6 from "../assets/Rectangle_6.png";
import rect7 from "../assets/Rectangle_7.png";
import Carousel from "../components/react/Carousel.tsx";
---

<Layout>
  <main class="overflow-x-hidden">
    <section
      class="hero-section relative h-[600px] w-full overflow-hidden min-[500px]:h-[707px] md:h-[745px] lg:h-[766px] xl:h-[826px]"
    >
      <div class="pointer-events-none absolute inset-0 select-none">
        <div class="absolute inset-0 bg-[#E6F0FA]" aria-hidden="true"></div>

        <div
          class="hero-dots absolute inset-0 top-[55%] left-[1%] h-[120%] w-[158%] bg-[length:100%_auto] bg-repeat md:top-[50%] md:left-[1%] md:h-[100%] md:w-[100%] lg:top-[4%] lg:left-[52%] lg:h-[158%] lg:w-[58%] lg:bg-[length:100%_auto] xl:top-[6%] xl:left-[50%] xl:h-[158%] xl:w-[58%]"
          style={`background-image: url('${dots.src}');`}
          aria-hidden="true"
        >
        </div>

        <div
          class="hero-makoto absolute top-[calc(50%+15px)] right-[-2%] z-0 h-[600px] w-auto translate-x-17 -translate-y-1/2 select-none min-[500px]:top-[54%] min-[500px]:right-[-17%] min-[500px]:h-[650px] min-[500px]:w-[clamp(470px,90vw,820px)] md:top-[53%] md:right-[-10%] md:h-[700px] md:w-[600px] lg:top-[53%] lg:right-[-5%] lg:h-[720px] lg:w-[600px] xl:top-[44%] xl:right-[-8%] xl:h-[760px] xl:w-[679px]"
          aria-hidden="true"
        >
          <img
            src={makoto.src}
            alt=""
            class="block h-full w-auto object-contain"
          />
        </div>
      </div>

      <div
        class="p3d-container relative z-10 mx-auto grid min-h-screen w-full max-w-7xl grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] px-4 pt-12 sm:px-6 sm:pt-16 md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] md:px-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:px-10 xl:grid-cols-2 xl:items-start"
      >
        <div
          class="hero-copy xs:pt-38 relative z-20 flex w-full max-w-[480px] flex-col items-start justify-start pt-35 text-left min-[500px]:pt-28 md:pt-8 lg:pt-24 xl:max-w-[600px] xl:pt-28"
        >
          <h1
            style="-webkit-text-stroke: 1.5px #001B3D;"
            class="font-bmspace mb-3 translate-y-5 text-[clamp(19px,5vw,55px)] leading-tight tracking-[-0.02em] text-[#001B3D] sm:text-[clamp(19px,5vw,55px)] xl:translate-y-1"
          >
            Downloads
          </h1>

          <p
            class="font-noto-sans max-w-[440px] translate-y-5 text-[clamp(14px,2.5vw,28px)] leading-snug font-semibold text-[#001B3D] xl:translate-y-3"
          >
            Next Minor Release (v1.2.0)
          </p>

          <p
            class="font-MgOpenCosmeticaBold max-w-[400px] translate-y-5 text-[clamp(13px,1.8vw,20px)] text-[#001B3D] xl:translate-y-3"
          >
            August 20, 2026
          </p>

          <div class="h-10 sm:h-12"></div>

          <p
            class="font-noto-sans max-w-[440px] -translate-y-2 text-[clamp(14px,2.5vw,28px)] leading-snug font-semibold text-[#001B3D] xl:translate-y-3"
          >
            Next Major Release (v2.0.0)
          </p>

          <p
            class="font-MgOpenCosmeticaBold max-w-[400px] -translate-y-2 text-[clamp(13px,1.8vw,20px)] text-[#001B3D] xl:translate-y-3"
          >
            September, 2026
          </p>

          <div
            class="scroll-mt relative mb-4 flex w-full shrink-0 translate-x-[calc(23.75vw-8px)] translate-y-15 justify-center"
          >
            <Button
              as="a"
              href="https://github.com/p3d-project/persona-3-dual/releases/tag/v1.1.0"
              target="_blank"
              size="lg"
              className="mx-auto w-[calc(100vw-40px)] shrink-0 justify-center text-2xl sm:py-1 sm:text-2xl md:mx-auto md:w-[clamp(560px,72vw,660px)] md:translate-y-[clamp(100px,18vw,140px)] md:py-5 md:text-2xl lg:mx-auto lg:w-[clamp(660px,64vw,790px)] lg:translate-y-[clamp(48px,4.7vw,65px)] lg:py-5 lg:text-3xl xl:mx-auto xl:w-[clamp(790px,45vw,900px)] xl:translate-y-[clamp(20px,2.5vw,40px)] xl:py-6"
            >
              Download v1.1.0
            </Button>
          </div>
        </div>
      </div>
    </section>

    <section
      class="whats-new-section relative z-20 -mt-4 mb-4 w-full bg-[#79CEFF] pb-32 sm:pb-40 md:-mt-12 md:pb-52 lg:-mt-24 lg:pb-35 xl:-mt-32"
    >
      <div class="mx-auto w-full max-w-7xl px-6 lg:px-10">
        <div class="max-w-2xl">
          <h2
            class="font-noto-sans mb-4 pt-8 text-[clamp(19px,2.5vw,28px)] font-semibold text-[#001B3D]"
          >
            What's New?
          </h2>

          <p
            class="font-noto-sans text-[clamp(16px,2vw,20px)] font-semibold text-[#001B3D]"
          >
            For specifics, check out our <a
              href="https://docs.p3dual.com/"
              target="_blank"
              class="text-[#12A858] underline"
            >
              documentation!
            </a>
          </p>

          <ul
            class="font-MgOpenCosmeticaBold mt-3 list-disc pl-5 text-[clamp(16px,2vw,20px)] text-[#001B3D]"
          >
            <li> fix: iwatodai street pause hud bug </li>
            <li> Fixed Red Debug Text Spilling into Pause Menu and Dialog Screen </li>
            <li> Refactor model magic check </li>
            <li> Removed templates </li>
            <li> Refactored globals.h controllers/components into singleton pattern </li>
            <li> fix: cutscene crash </li>
            <li> Add devcontainer support and Docker-based debugging </li>
            <li> Create MenuBackgroundScreen class </li>
            <li> fix: changed version from 0.6 to 1.0.0 </li>
            <li> Build: Added Flag to skip SD Card Generation </li>
            <li> Added compressed music files </li>
            <li> Implement Game Engine HLD into header file </li>
            <li> Allow to skip elizabeth scroll animation on main title </li>
            <li> Updated docs & moved into home directory </li>
            <li> Create EnvironmentView class </li>
            <li> Dockerfile add pre-commit install, comply with linting </li>
            <li> Fix: Added environment generation back into makefile  </li>
            <li> Added fog, character outline support </li>
            <li> Create Custom Text Engine </li>
            <li> Document battle related code </li>
            <li> Reduced Audio Stuttering during scene loading </li>
            <li> Added correct music looping point for iwatodai_dorm.pcm in IwatodaiDormView.cpp </li>
            <li> Fix links in README.md for installation and roadmap </li>
            <li> redid animation fixes </li>
            <li> Added art standard colors to custom palette and created TextColor enum </li>
            <li> Added Appear Function for Text </li>
            <li> Create CameraController </li>
            <li> Replaced console in menus with the text controller </li>
            <li> create enemy profiles / fix 2nd battle not finding participants bug </li>
            <li> Fix Music Cutout or Game Reset on Camera Mode Switch </li>
            <li> Added rudimentary color switching to TextController.</li>
            <li> Reset menu hierarchy state on exit </li>
            <li> Deploy Doxygen via GitHub Action </li>
            <li> Added Text Styling </li>
            <li> Add Doyxgen site styling </li>
            <li> Update Dialogue Converter for new Text Engine </li>
            <li> Added enviroments to Makefile clean target </li>
            <li> Migrate BaseMenu to MenuBackgroundScreen </li>
            <li> Clean up BaseView's references </li>
            <li> Port to BlocksDS SDK </li>
            <li> Replaced BattleController with BattleSystem </li>
            <li> Replaced CameraController with CameraSystem + MathManager </li>
            <li> Replaced CharacterController with MovementComponent </li>
            <li> Replaced DialogueController with DialogueComponent </li>
            <li> Replaced SaveController with SaveSystem + IOManager </li>
            <li> Replaced GraphicsController, SpriteController with GraphicsComponent </li>
            <li> Added updated icon </li>
            <li> Replaced TextController with TextManager, TextSystem, & TextComponent </li>
            <li> Fix new textures being visible on old environment when switching  </li>
            <li> Activate / end camera and movement im menus </li>
            <li> Replaced UIController with UISystem, & created RenderManager </li>
            <li> Delete CONTRIBUTING.md </li>
            <li> Refactored BaseMenu to work with UISystem </li>
            <li> Add customizable close behavior to UIMenu classes </li>
            <li> Dialogue fix </li>
            <li> Updated version number in settings to v1.1.0 </li>
            <li> Update README attributions </li>
            <li> Deleted tools/website folder </li>
            <li> Set correct camera configs for all Views </li>
            <li> TextComponent: Stop text animation bleeding on screen. </li>
            <li> Removed femc </li>
            <li> Rename .h headers to .hpp for C++ convention </li>
            <li> Migrate SignContractView to TextSystem </li>
            <li> Updated skyBackground, skyBackgroundSub to use 16 colour palette </li>
            <li> Updated font to more legible font, correct font sizes </li>
            <li> Reduce uisystem available slots </li>
            <li> Separate global structs/enums from structs/enums.hpp </li>
            <li> Fix memory leak </li>
            <li> EnvironmentView: Set glClearPolyID to 0 to remove outline border.</li>
          </ul>
        </div>

        <div
          class="whats-new-art pointer-events-none absolute top-[6%] right-[3%] hidden w-[clamp(350px,38vw,750px)] lg:block"
        >
          <img
            src={glass.src}
            alt=""
            class="relative z-0 w-full object-contain"
          />

          <img
            src={rect7.src}
            alt=""
            class="absolute top-[15%] left-[8%] z-10 w-[clamp(165px,15vw,285px)]"
          />

          <img
            src={rect5.src}
            alt=""
            class="absolute top-[15%] right-[14%] z-10 w-[clamp(165px,15vw,285px)]"
          />

          <img
            src={rect6.src}
            alt=""
            class="absolute top-[58%] left-1/2 z-10 w-[clamp(165px,15vw,285px)] -translate-x-1/2 -translate-y-[12%]"
          />
        </div>

        <div
          class="whats-new-carousel mt-10 flex w-full justify-center lg:hidden"
        >
          <div class="relative w-[min(360px,92vw)]">
            <img
              src={glass.src}
              alt=""
              class="relative z-0 block h-auto w-full object-contain"
            />

            <div
              class="absolute top-1/2 left-1/2 z-10 w-[min(250px,68vw)] -translate-x-1/2 -translate-y-1/2"
            >
              <Carousel client:load />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
