---
import Layout from "../layouts/Layout.astro";
import Button from "../components/react/Button.tsx";
import dots from "../assets/Dots.svg";
import glass from "../assets/glass.png";
import makoto from "../assets/makoto_standing1.png";
import marked from "../assets/glass_marked.png";
import rect5 from "../assets/Rectangle_5.png";
import rect6 from "../assets/Rectangle_6.png";
import rect7 from "../assets/Rectangle_7.png";
import Carousel from "../components/react/Carousel.tsx";
---

<Layout>
  <main class="overflow-x-hidden">

    <section class="hero-section relative min-h-screen w-full overflow-hidden">

      <div class="pointer-events-none absolute inset-0 select-none">

        <div
          class="absolute inset-x-0 top-0 h-[calc(100%+300px)] bg-[#E6F0FA]"
          aria-hidden="true"
        ></div>

       <div class=" hero-dots absolute top-[55%] left-[10%]
        h-[120%] w-[58%] bg-[length:130%_auto] bg-repeat

        sm:left-[50%]
        sm:w-[58%]
        sm:top-[55%]
        sm:bg-[length:130%_auto]

        md:left-[10%]
        md:top-[55%]
        md:w-[50%]
        md:bg-[length:130%_auto]
    
        lg:left-[42%]
        lg:top-[4%]
        lg:h-[158%]
        lg:w-[58%]
        lg:bg-[length:auto_auto]

        xl:left-[42%]
        xl:top-[6%]
        xl:w-[58%]
        xl:bg-[length:auto_auto]"
        style={`background-image: url('${dots.src}');`}
        aria-hidden="true"></div>

    <div class="hero-makoto absolute z-0 select-none top-[59%]
    right-[-2%] w-[clamp(300px,82vw,460px)] -translate-y-1/2
    sm:top-[57%]
    sm:right-[-1%]
    sm:w-[clamp(360px,78vw,540px)]

    md:top-[56%]
    md:right-[-3%]
    md:w-[clamp(560px,78vw,760px)]

    lg:top-[55%]
    lg:right-[-5%]
    lg:w-[clamp(520px,56vw,780px)]

    xl:top-[56%]
    xl:right-[-4%]
    xl:w-[clamp(600px,52vw,900px)]"
  aria-hidden="true">
  <img
    src={makoto.src}
    alt=""
    class="block h-auto w-full object-contain"/>
  </div>
</div>

      <div class="p3d-container relative z-10 mx-auto grid min-h-screen w-full
          max-w-7xl grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] px-4
          pt-12

          sm:px-6
          sm:pt-16

          md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]
          md:px-8

          lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]
          lg:px-10

          xl:grid-cols-2
          xl:items-start">

        <div class="hero-copy flex w-full max-w-[480px] flex-col
            items-start justify-start pt-8 text-left

            sm:pt-12
            md:pt-20
            lg:pt-24
            xl:max-w-[600px]
            xl:pt-28">

          <h1
            style="-webkit-text-stroke: 1.5px #001B3D;"
            class="font-bmspace mb-3 translate-y-5 text-[clamp(24px,5vw,55px)] leading-tight
              tracking-[-0.02em] text-[#001B3D]

              xl:translate-y-1">
            Downloads
          </h1>

          <p class="font-noto-sans max-w-[440px] translate-y-5 text-[clamp(14px,2.5vw,28px)]
              leading-snug font-semibold text-[#001B3D]

              xl:translate-y-3">
            Next Minor Release (v1.2.0)
          </p>


          <p
            class="font-MgOpenCosmeticaBold max-w-[400px] translate-y-5
              text-[clamp(13px,1.8vw,20px)] text-[#001B3D]

              xl:translate-y-3">
            August 20, 2026
          </p>


          <div class="h-10 sm:h-12"></div>

          <p class="font-noto-sans max-w-[440px] -translate-y-2 text-[clamp(14px,2.5vw,28px)]
              leading-snug font-semibold text-[#001B3D]

              xl:translate-y-3">
            Next Major Release (v2.0.0)
          </p>


          <p class="font-MgOpenCosmeticaBold max-w-[400px] -translate-y-2
          text-[clamp(13px,1.8vw,20px)] text-[#001B3D]

          xl:translate-y-3">
            September, 2026
          </p>

          <div class="mt-20 flex w-full justify-start

              sm:mt-24

              md:mt-28">
            <Button
              as="a"
              href="https://github.com/p3d-project/persona-3-dual/releases/tag/v1.1.0"
              target="_blank"
              size="lg"
              className="w-[min(260px,45vw)] justify-center text-xl

                sm:w-[min(280px,42vw)]
                sm:py-5
                sm:text-2xl

                md:w-[min(310px,40vw)]
                md:text-3xl

                lg:w-[min(410px,38vw)]
                lg:py-7
                lg:text-4xl

                xl:w-[min(700px,42vw)]
                xl:py-8">
              Download v1.1.0
            </Button>
          </div>

        </div>

      </div>
    </section>


    <section class="whats-new-section relative z-20
    mb-4 -mt-4 w-full bg-[#79CEFF] pb-32
    
    sm:pb-40

    md:-mt-8
    md:pb-52

    lg:-mt-20
    lg:pb-35

    xl:-mt-28">

      <div class="mx-auto w-full max-w-7xl px-6
          lg:px-10">

        <div class="max-w-2xl">

          <h2 class="font-noto-sans mb-4 pt-8
          text-[clamp(19px,2.5vw,28px)] font-semibold text-[#001B3D]">
            What's New?
          </h2>


          <p class="font-noto-sans text-[clamp(16px,2vw,20px)] font-semibold
          text-[#001B3D]">
            For specifics, check out our
            <a
              href="https://docs.p3dual.com/"
              target="_blank"
              class="text-[#12A858] underline"
            >
              documentation!
            </a>
          </p>


          <ul class="font-MgOpenCosmeticaBold mt-3 list-disc
          pl-5 text-[clamp(16px,2vw,20px)] text-[#001B3D]">
            <li>Replaced AI systems</li>
            <li>Retooled and rebuilt Aegis-Engine</li>
            <li>Added vertex lighting workflow support</li>
            <li>Migrated from devkitpro NDS to BlocksDS</li>
            <li>Replaced graphics rendering system</li>
            <li>Revamped controls</li>
            <li>Revamped UI for all menus</li>
            <li>Custom text engine</li>
            <li>Controllable Camera</li>
            <li>Optimized VRAM usage</li>
            <li>New dialogue busts with multiple facial expressions</li>
            <li>A World Map</li>
            <li>Custom music tracks</li>
            <li>Custom 3D models for props, environment, and characters</li>
          </ul>

        </div>

        <div class="whats-new-art pointer-events-none absolute
        right-[3%] top-[6%] hidden w-[clamp(350px,38vw,750px)]
        lg:block">

          <img
            src={glass.src}
            alt=""
            class="relative z-0 w-full object-contain"
          />

          <img
            src={rect7.src}
            alt=""
            class="absolute left-[8%] top-[15%] z-10
            w-[clamp(165px,15vw,285px)]"/>

          <img
            src={rect5.src}
            alt=""
            class="absolute right-[14%] top-[15%]
            z-10 w-[clamp(165px,15vw,285px)]"/>

          <img
            src={rect6.src}
            alt=""
            class="absolute left-1/2 top-[58%] z-10
            w-[clamp(165px,15vw,285px)] -translate-x-1/2 -translate-y-[12%]"/>

        </div>


<div class="whats-new-carousel mt-10 flex
            w-full justify-center
            lg:hidden">
  
  <div class="relative w-[min(360px,92vw)]">

    <img
      src={glass.src}
      alt=""
      class="relative z-0 block h-auto
        w-full object-contain"/>

    <div class="absolute left-1/2 top-1/2
        z-10 w-[min(250px,68vw)] -translate-x-1/2
        -translate-y-1/2">
      <Carousel client:load />
    </div>

  </div>
</div>
</div>
    </section>

    <section class="legacy-section relative z-20
                    -mt-16 bg-[#E6F0FA] pb-32
                    sm:pb-40">

      <div class="mx-auto w-full max-w-7xl px-6 lg:px-10">

        <h2 class="font-noto-sans mb-4 pt-8
            text-[clamp(19px,2.5vw,28px)] font-semibold text-[#001B3D]">
          Legacy versions
        </h2>

        <article class="legacy-release grid gap-8
                        border-b border-[#001B3D]/10
                        py-12

                      md:grid-cols-[minmax(0,1fr)_minmax(280px,400px)]
                      md:grid-rows-[auto_auto]
                      md:items-center

                      lg:gap-16">

          <div class="md:col-start-1 md:row-start-1">

            <div class="flex flex-wrap items-center gap-30 md:gap-30 lg:gap-46 xl:gap-86">

              <p class="font-noto-sans text-[clamp(19px,2vw,20px)] font-semibold
                  text-[#001B3D] underline">
                v1.0.0
              </p>

              <p class="font-noto-sans text-[clamp(14px,1.5vw,16px)] font-semibold
                        text-[#001B3D]">
                June 28th, 2026
              </p>

            </div>

            <p class="font-noto-sans mt-6 max-w-[680px] text-[clamp(16px,1.8vw,20px)]
                leading-relaxed font-semibold text-[#001B3D]">
              Milestone 1 marks the first major release of Persona 3 Dual.
              It introduces initial 3D exploration across multiple key
              locations, basic character interactions, a functional battle
              system demo, and core UI and settings features.
            </p>

          </div>


          <div class="flex justify-center

              md:col-start-2
              md:row-start-1
              md:row-span-2
              md:justify-end">
            <img
              src={rect6.src}
              alt=""
              class="w-[clamp(220px,28vw,400px)]max-w-full drop-shadow-[8px_8px_0_#3BAA45]"/>
          </div>

          <div class="mt-2 flex justify-start

              md:col-start-1
              md:row-start-2
              md:mt-0
            "
          >
            <Button
              as="a"
              href="https://github.com/p3d-project/persona-3-dual/releases/tag/v1.0.0"
              target="_blank"
              size="md"
              className="w-[min(310px,85vw)] justify-center py-3 text-2xl
                sm:text-3xl
                lg:w-[410px]">
              Download
            </Button>
          </div>

        </article>


        <article class="legacy-release grid gap-8 py-12

            md:grid-cols-[minmax(0,1fr)_minmax(280px,400px)]
            md:grid-rows-[auto_auto]
            md:items-center

            lg:gap-16">

          <div class="md:col-start-1 md:row-start-1">

            <div class="flex flex-wrap items-center gap-30 md:gap-30 lg:gap-46 xl:gap-86">

              <p class="font-noto-sans text-[clamp(19px,2vw,20px)] font-semibold
                        text-[#001B3D] underline">
                v0.6.0
              </p>

              <p class="font-noto-sans text-[clamp(14px,1.5vw,16px)] font-semibold text-[#001B3D]">
                June 26th, 2026
              </p>

            </div>

            <p class=" font-noto-sans mt-6 max-w-[680px]
            text-[clamp(16px,1.8vw,20px)] leading-relaxed
            font-semibold text-[#001B3D] ">
              A pre-release for v1.0.0 focused on testing for Milestone 1.
              Standardizes character dialogue formatting, updates model
              assets, and fixes critical turn-handling and save file bugs
              across platforms.
            </p>

          </div>


          <div class="flex justify-center

              md:col-start-2
              md:row-start-1
              md:row-span-2
              md:justify-end">
            <img
              src={rect6.src}
              alt=""
              class="w-[clamp(220px,28vw,400px)] max-w-full drop-shadow-[8px_8px_0_#3BAA45]"/>
          </div>


          <div class="mt-2 flex justify-start

              md:col-start-1
              md:row-start-2
              md:mt-0">
            <Button
              as="a"
              href="https://github.com/p3d-project/persona-3-dual/releases/tag/0.6"
              target="_blank"
              size="md"
              className="w-[min(310px,85vw)] justify-center py-3 text-2xl
                sm:text-3xl
                lg:w-[410px]">
              Download
            </Button>
          </div>

        </article>


        <article class="legacy-release grid gap-8 py-12

            md:grid-cols-[minmax(0,1fr)_minmax(280px,400px)]
            md:grid-rows-[auto_auto]
            md:items-center

            lg:gap-16">

          <div class="md:col-start-1 md:row-start-1">

            <div class="flex flex-wrap items-center gap-30 md:gap-30 lg:gap-46 xl:gap-86">

              <p class="font-noto-sans text-[clamp(19px,2vw,20px)] font-semibold text-[#001B3D] underline"
              >
                v0.5.0
              </p>

              <p class="font-noto-sans text-[clamp(14px,1.5vw,16px)] font-semibold text-[#001B3D]"
              >
                June 22th, 2026
              </p>

            </div>

            <p class="font-noto-sans mt-6 max-w-[680px] text-[clamp(16px,1.8vw,20px)]
                leading-relaxed font-semibold text-[#001B3D]">
              A test release targeting video playback and rendering fixes.
              Resolves z-fighting visual glitches in 3D environments,
              improves cutscene aspect ratios, and resolves title screen
              input bugs.
            </p>

          </div>


          <div class="flex justify-center

              md:col-start-2
              md:row-start-1
              md:row-span-2
              md:justify-end">
            <img
              src={rect6.src}
              alt=""
              class="w-[clamp(220px,28vw,400px)] max-w-full drop-shadow-[8px_8px_0_#3BAA45]"/>
          </div>


          <div class="mt-2 flex justify-start

              md:col-start-1
              md:row-start-2
              md:mt-0">
            <Button
              as="a"
              href="https://github.com/p3d-project/persona-3-dual/releases/tag/0.5"
              target="_blank"
              size="md"
              className="w-[min(310px,85vw)] justify-center py-3 text-2xl
                sm:text-3xl
                lg:w-[410px]">
              Download
            </Button>
          </div>

        </article>

        <article class="legacy-release grid gap-8 py-12

            md:grid-cols-[minmax(0,1fr)_minmax(280px,400px)]
            md:grid-rows-[auto_auto]
            md:items-center

            lg:gap-16">

          <div class="md:col-start-1 md:row-start-1">

            <div class="flex flex-wrap items-center gap-30 md:gap-30 lg:gap-46 xl:gap-86">

              <p class="font-noto-sans text-[clamp(19px,2vw,20px)] font-semibold text-[#001B3D] underline"
              >
                v0.4.0
              </p>

              <p class="font-noto-sans text-[clamp(14px,1.5vw,16px)] font-semibold text-[#001B3D]"
              >
                June 20th, 2026
              </p>

            </div>

            <p class="font-noto-sans mt-6 max-w-[680px] text-[clamp(16px,1.8vw,20px)] 
            leading-relaxed font-semibold text-[#001B3D]">
              Early preview release for testing core gameplay features.
              Integrates preliminary 3D environment exploration, basic
              character dialogue interactions, and debug tools.
            </p>

          </div>


          <div class="flex justify-center

              md:col-start-2
              md:row-start-1
              md:row-span-2
              md:justify-end">
            <img
              src={rect6.src}
              alt=""
              class=" w-[clamp(220px,28vw,400px)] max-w-full drop-shadow-[8px_8px_0_#3BAA45]"/>
          </div>


          <div class="mt-2 flex justify-start

              md:col-start-1
              md:row-start-2
              md:mt-0">
            <Button
              as="a"
              href="https://github.com/p3d-project/persona-3-dual/releases/tag/0.4"
              target="_blank"
              size="md"
              className="w-[min(310px,85vw)] justify-center py-3 text-2xl
                sm:text-3xl
                lg:w-[410px]">
              Download
            </Button>
          </div>

        </article>

        <article class="legacy-release grid gap-8 py-12

            md:grid-cols-[minmax(0,1fr)_minmax(280px,400px)]
            md:grid-rows-[auto_auto]
            md:items-center

            lg:gap-16">

          <div class="md:col-start-1 md:row-start-1">

            <div class="flex flex-wrap items-center gap-30 md:gap-30 lg:gap-46 xl:gap-86">

              <p class="font-noto-sans text-[clamp(19px,2vw,20px)] font-semibold text-[#001B3D] underline"
              >
                v0.3.0
              </p>

              <p class="font-noto-sans text-[clamp(14px,1.5vw,16px)] font-semibold text-[#001B3D]"
              >
                May 29th, 2026
              </p>

            </div>

            <p class="font-noto-sans mt-6 max-w-[680px] text-[clamp(16px,1.8vw,20px)] 
              leading-relaxed font-semibold text-[#001B3D]">
              Early preview release, introducing early 3D camera controls,
              movement, and initial battle system prototypes.
            </p>
          </div>

          <div class="flex justify-center

              md:col-start-2
              md:row-start-1
              md:row-span-2
              md:justify-end">
            <img
