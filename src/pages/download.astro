                sm:text-3xl
                lg:w-[410px]">
              Download
            </Button>
          </div>
        </article>

        <article class="legacy-release grid gap-8 py-12

            md:grid-cols-[minmax(0,1fr)_minmax(280px,400px)]
            md:grid-rows-[auto_auto]
            md:items-center

            lg:gap-16">

          <div class="md:col-start-1 md:row-start-1">

            <div class="flex flex-wrap items-center gap-30 md:gap-30 lg:gap-46 xl:gap-86">

              <p class="font-noto-sans text-[clamp(19px,2vw,20px)] font-semibold text-[#001B3D] underline"
              >
                v0.2.0
              </p>

              <p class="font-noto-sans text-[clamp(14px,1.5vw,16px)] font-semibold text-[#001B3D]"
              >
                April 27th, 2026
              </p>

            </div>

            <p class="font-noto-sans mt-6 max-w-[680px]
                text-[clamp(16px,1.8vw,20px)] leading-relaxed font-semibold
                text-[#001B3D]">
              Technical update focusing on media pipelines and performance
              optimizations. Adds introductory video support, transitions
              audio to uncompressed format, and implements automated asset
              processing pipelines.
            </p>
          </div>

          <div class="flex justify-center

              md:col-start-2
              md:row-start-1
              md:row-span-2
              md:justify-end">
            <img
              src={rect6.src}
              alt=""
              class="w-[clamp(220px,28vw,400px)] max-w-full drop-shadow-[8px_8px_0_#3BAA45]"/>
          </div>


          <div class="mt-2 flex justify-start

              md:col-start-1
              md:row-start-2
              md:mt-0">
            <Button
              as="a"
              href="https://github.com/p3d-project/persona-3-dual/releases/tag/0.2"
              target="_blank"
              size="md"
              className="w-[min(310px,85vw)] justify-center py-3 text-2xl
                sm:text-3xl
                lg:w-[410px]">
              Download
            </Button>
          </div>
        </article>

        <article class="legacy-release grid gap-8 py-12

            md:grid-cols-[minmax(0,1fr)_minmax(280px,400px)]
            md:grid-rows-[auto_auto]
            md:items-center

            lg:gap-16">

          <div class="md:col-start-1 md:row-start-1">

            <div class="flex flex-wrap items-center gap-30 md:gap-30 lg:gap-46 xl:gap-86">

              <p class="font-noto-sans text-[clamp(19px,2vw,20px)] font-semibold text-[#001B3D] underline"
