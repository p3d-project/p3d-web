        </div>

        <div
          class="hero-makoto absolute max-w-none select-none top-[58%] -left-[10px] h-[600px] w-[600px] -translate-x-6 -translate-y-1/2 lg:top-[58%] lg:right-[2.1%] lg:left-[50%] lg:block lg:h-[1100px] lg:w-[1100px] lg:translate-x-[6%]"
          aria-hidden="true"
