---
import Layout from "../layouts/Layout.astro";
import Button from "../components/react/Button.tsx";
import TeamGrid from "../components/react/TeamGrid.tsx";
import arrowSvg from "../assets/Arrow-7.svg?raw";
import dotsPattern from "../assets/Dots.svg";
import glassBg from "../assets/GlassBG.svg";
---

<Layout>
  <main>
    {/* Hero / About Section */}
    <section
      id="index"
      class="relative min-h-screen w-full overflow-hidden bg-[#E6F0FA]"
    >
      {/* Background Layer: Dots Pattern & Glass */}
      <div
        class="pointer-events-none absolute inset-0 overflow-hidden select-none"
      >
        {
          /* 1. Dots Pattern: Full background on mobile, right-aligned on desktop */
        }
        <div
          class="absolute inset-0 bg-repeat lg:left-[47%]"
          style={`background-image: url('${dotsPattern.src}'); background-size: auto;`}
        >
        </div>

        {/* 2a. Glass Overlay (Desktop) */}
        <img
          src={glassBg.src}
          alt=""
          aria-hidden="true"
          class="absolute top-1/2 right-0 hidden h-[1100px] w-auto max-w-none translate-x-[30%] -translate-y-1/2 object-contain lg:block"
        />
      </div>

      {/* Grid Container */}
      <div
        class="relative z-10 grid min-h-screen w-full grid-cols-1 px-4 pt-16 sm:px-12 lg:grid-cols-12 lg:pr-6 lg:pl-16"
      >
        {/* Left / Top Column: Content Container */}
        <div
          class="relative flex flex-col items-center justify-start pt-6 pr-0 pb-10 text-center sm:pt-10 lg:col-span-5 lg:items-start lg:pt-28 lg:pr-4 lg:pb-16 lg:text-left"
        >
          {
            /* 2b. Glass Overlay (Mobile) - Nudged down just a few more pixels */
          }
          <div
            class="pointer-events-none absolute -inset-x-12 -top-16 -z-10 block lg:hidden"
          >
            <img
              src={glassBg.src}
              alt=""
              aria-hidden="true"
              class="absolute top-1/2 left-1/2 h-[210vw] max-h-[1400px] min-h-[1200px] w-auto max-w-none -translate-x-1/2 -translate-y-[42%] rotate-90 object-contain"
            />
          </div>

          {/* Header */}
          <h1
            style="font-family: 'BM space'; -webkit-text-stroke: 1.5px #001B3D;"
            class="mb-3 text-4xl leading-tight tracking-[-0.02em] text-[#001B3D] sm:text-5xl lg:mb-6 lg:text-[55px]"
          >
            About Us
          </h1>

          {/* Body Paragraph */}
          <p
            style="font-family: 'Noto Sans JP', sans-serif;"
            class="max-w-[440px] px-2 text-base leading-snug font-semibold text-[#001B3D] sm:px-0 sm:text-xl lg:text-[28.1px]"
          >
            Our goal and what unites us around that goal are simple: love for
            Persona 3 and for the Nintendo DS. P3D is not simply us asking “what
            if,” but forging a tailored experience from the ground-up. To
            accomplish this, we divided ourselves into several teams.
          </p>

          {/* Explore Link & Arrow */}
          <a
            href="#team"
            class="group mt-3 inline-flex cursor-pointer flex-col items-center gap-1.5 sm:mt-5 sm:gap-2 lg:mt-12 lg:flex-row lg:gap-6"
          >
            <p
              style="font-family: 'Noto Sans JP', sans-serif;"
              class="order-1 text-xl leading-tight font-extrabold text-[#000024] sm:text-2xl lg:order-2 lg:w-[229px] lg:text-[35.2px]"
            >
              Explore the teams
            </p>
            <div
              class="order-2 flex-shrink-0 transition-transform duration-300 ease-in-out group-hover:translate-y-2 lg:order-1 [&>svg]:h-[45px] [&>svg]:w-auto sm:[&>svg]:h-[70px] lg:[&>svg]:h-[167px]"
              set:html={arrowSvg}
            />
          </a>
        </div>

        {/* Right / Bottom Column: Character Silhouettes Canvas */}
        <div
          class="relative flex h-full w-full items-center justify-center pt-4 pb-16 lg:col-span-7 lg:justify-end lg:py-0 lg:pl-12"
        >
          <TeamGrid client:load />
        </div>
      </div>
    </section>

    {/* Team Section */}
    <section
      id="team"
      class="relative z-10 w-full scroll-mt-16 bg-[#000024] py-16"
    >
      <div class="container mx-auto px-4 md:px-8">
        <Button size="lg" className="w-full justify-center py-5 text-4xl">
          Join Now!
        </Button>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  /* Temporary local fixes - remove once PR changes land in main */
  #navbar {
    z-index: 50 !important;
  }
  html {
    scroll-behavior: smooth !important;
  }
</style>
