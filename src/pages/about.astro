---
import Layout from "../layouts/Layout.astro";
import Button from "../components/react/Button.tsx";
import TeamGrid from "../components/react/TeamGrid.tsx";
import TeamCarousel from "../components/react/TeamCarousel.tsx";
import arrowSvg from "../assets/Arrow-7.svg?raw";
import dotsPattern from "../assets/Dots.svg";
import glassBg from "../assets/GlassBG.svg";
---

<Layout>
  <main>
    {/* Hero — intro copy and team selection grid */}
    <section
      id="index"
      class="relative min-h-screen w-full overflow-hidden bg-[#E6F0FA]"
    >
      {/* Background — dot pattern and glass overlays */}
      <div
        class="pointer-events-none absolute inset-0 overflow-hidden select-none"
      >
        {/* Dot pattern: full width on mobile, right half on desktop */}
        <div
          class="absolute inset-0 bg-repeat lg:left-[43%]"
          style={`background-image: url('${dotsPattern.src}'); background-size: auto;`}
        >
        </div>

        {/* Glass overlay — desktop */}
        <img
          src={glassBg.src}
          alt=""
          aria-hidden="true"
          class="absolute top-1/2 right-0 hidden h-[1100px] w-auto max-w-none translate-x-[30%] -translate-y-1/2 object-contain lg:block"
        />
      </div>

      {/* Page grid — intro column and team grid column */}
      <div
        class="relative z-10 grid min-h-screen w-full grid-cols-1 px-4 pt-16 sm:px-12 lg:grid-cols-12 lg:pr-6 lg:pl-16"
      >
        {/* Intro column — copy and scroll cue */}
        <div
          class="relative flex flex-col items-center justify-start pt-6 pr-0 pb-24 text-center sm:pt-10 lg:col-span-5 lg:items-start lg:pt-28 lg:pr-4 lg:pb-16 lg:text-left"
        >
          {/* Glass overlay — mobile (rotated) */}
          <div
            class="pointer-events-none absolute -inset-x-12 -top-16 -z-10 block lg:hidden"
          >
            <img
              src={glassBg.src}
              alt=""
              aria-hidden="true"
              class="absolute top-1/2 left-1/2 h-[1375px] min-h-[1275px] w-auto max-w-none -translate-x-1/2 -translate-y-[41.5%] rotate-90 object-contain"
            />
          </div>

          <h1
            style="-webkit-text-stroke: 1.5px #001B3D;"
            class="font-bmspace mb-3 text-4xl leading-tight tracking-[-0.02em] text-[#001B3D] sm:text-5xl lg:mb-6 lg:text-[55px]"
          >
            About Us
          </h1>

          <p
            class="font-noto-sans max-w-[440px] px-2 text-base leading-snug font-semibold text-[#001B3D] sm:px-0 sm:text-xl lg:text-[28.1px]"
          >
            Our goal and what unites us around that goal are simple: love for
            Persona 3 and for the Nintendo DS. P3D is not simply us asking “what
            if,” but forging a tailored experience from the ground-up. To
            accomplish this, we divided ourselves into several teams.
          </p>

          {/* Scroll cue — links to the team detail section */}
          <button
            id="scroll-cue-btn"
            type="button"
            class="group mt-3 inline-flex cursor-pointer flex-col items-center bg-transparent border-0 p-0 gap-1.5 sm:mt-5 sm:gap-2 lg:mt-12 lg:flex-row lg:gap-6"
          >
            <span
              class="font-noto-sans order-1 text-xl leading-tight font-extrabold text-[#000024] sm:text-2xl lg:order-2 lg:w-[229px] lg:text-[35.2px]"
            >
              Explore the teams
            </span>
            <div
              class="order-2 flex-shrink-0 transition-transform duration-300 ease-in-out group-hover:translate-y-2 lg:order-1 [&>svg]:h-[45px] [&>svg]:w-auto sm:[&>svg]:h-[70px] lg:[&>svg]:h-[167px]"
              set:html={arrowSvg}
            />
          </button>
        </div>

        {/* Team grid column — hydrated React island */}
        <div
          class="relative flex h-full w-full items-center justify-center pt-10 pb-16 lg:col-span-7 lg:justify-end lg:py-0 lg:pl-12"
        >
          <TeamGrid client:load />
        </div>
      </div>
    </section>

    {/* Team detail — join CTA and carousel */}
    <section
      id="team"
      class="relative z-10 w-full scroll-mt-16 bg-[#000024] pt-10 pb-0 overflow-hidden sm:pt-12"
    >
      {/* Join CTA */}
      <div class="w-full mb-1 px-4 sm:mb-2 sm:px-12 lg:pl-20 lg:pr-12">
        <Button
          as="a"
          href="https://docs.p3dual.com/guides/team-application/"
          size="lg"
          className="w-full justify-center py-5 text-4xl"
        >
          Join Now!
        </Button>
      </div>

      {/* Team carousel — hydrated React island */}
      <TeamCarousel client:load />
    </section>
  </main>
</Layout>

{/* Align carousel header padding with Join CTA on desktop without affecting cog positioning */}
<style>
  @media (min-width: 1024px) {
    :global(#team .relative.z-10.mb-20.flex.w-full.items-center.justify-between),
    :global(#team .relative.z-10.mb-12.flex.w-full.items-center.justify-between),
    :global(#team .relative.z-10.flex.w-full.items-center.justify-between) {
      padding-left: 5rem; /* matches lg:pl-20 */
      padding-right: 3rem; /* matches lg:pr-12 */
    }
  }
</style>

{/* Scroll cue button click handler — scrolls to the team detail section */}
<script>
  document.getElementById("scroll-cue-btn")?.addEventListener("click", () => {
    document.getElementById("team")?.scrollIntoView();
  });
</script>