---
import Layout from "../layouts/Layout.astro";

import socialIcons from "../assets/social-icons.svg?url";
---

<Layout>
  <section id="section-coming-soon" class="space-y-2">
    <div class="container mx-auto flex flex-col items-center gap-6 py-8">
      <img src="/favicon.jpeg" class="h-50" />

      <div>
        <h1 class="text-center text-5xl">Coming Soon!</h1>
        <p class="text-center text-2xl">
          The Persona 3 Dual website is under construction. Please check back
          soon!
        </p>
      </div>

      <p class="text-2xl">
        Looking for the <a
          href="https://docs.p3dual.com"
          target="_blank"
          class="hyperlink">docs</a
        >?
      </p>

      <div
        class="flex flex-wrap justify-center gap-2 [&>a>svg]:size-25 [&>a>svg]:text-gray-500 [&>a>svg]:transition-colors [&>a>svg]:hover:text-gray-200"
      >
        <a
          href="https://www.youtube.com/@TheP3DProject"
          target="_blank"
          class="block"
        >
          <svg>
            <title>YouTube icon</title>
            <use href=`${socialIcons}#youtube`></use>
          </svg>
        </a>
        <a
          href="https://www.reddit.com/user/p3d-project/"
          target="_blank"
          class="block"
        >
          <svg>
            <title>Reddit icon</title>
            <use href=`${socialIcons}#reddit`></use>
          </svg>
        </a>
        <a href="https://x.com/thep3dproject" target="_blank" class="block">
          <svg>
            <title>X icon</title>
            <use href=`${socialIcons}#xelon`></use>
          </svg>
        </a>
        <a
          href="https://bsky.app/profile/thep3dproject.bsky.social"
          target="_blank"
          class="block"
        >
          <svg>
            <title>Bluesky icon</title>
            <use href=`${socialIcons}#bluesky`></use>
          </svg>
        </a>
        <a
          href="https://www.instagram.com/thep3dproject/"
          target="_blank"
          class="block"
        >
          <svg>
            <title>Instagram icon</title>
            <use href=`${socialIcons}#instagram`></use>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
