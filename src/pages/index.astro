---
import Button from "../components/react/Button";
import Layout from "../layouts/Layout.astro";
import HeroDS from "../components/HeroDS.astro";
import ProjectTimeline from "../components/react/ProjectTimeline";

import showcase1Image from "../assets/showcase_1.webp?url";
import showcase2Image from "../assets/showcase_2.webp?url";
import showcase3Image from "../assets/showcase_3.webp?url";
import tiktokCard from "../assets/card_tiktok.webp?url";
import xCard from "../assets/card_x.webp?url";
import redditCard from "../assets/card_reddit.webp?url";
import instagramCard from "../assets/card_instagram.webp?url";

import DownloadNowText from "../assets/download_now.svg";
---

<Layout>
  <main class="p3d-navbar-pad">
    <section id="hero" class="relative">
      <!-- TODO: missing the dots background -->
      <div class="dot-bg absolute top-0 right-0 -z-1 h-full w-full md:w-[60%]">
      </div>

      <div
        class="absolute top-0 right-0 h-full w-auto lg:static lg:flex lg:h-auto lg:w-full lg:justify-end"
      >
        <HeroDS
          class="md:text-primary h-full w-auto text-[#79CEFF] lg:h-auto lg:w-[50%]"
        />
      </div>

      <div
        class="p3d-container relative flex flex-col gap-4 py-10 md:gap-10 md:py-15 lg:absolute lg:top-0 lg:bottom-0 lg:left-[50%] lg:translate-x-[-50%] lg:justify-center lg:gap-20 lg:py-0"
      >
        <div class="flex flex-col gap-10">
          <h1 class="font-bmspace text-2xl md:text-3xl lg:text-[3cqi]">
            Introducing Persona 3 <span class="text-secondary">Dual</span>
          </h1>

          <p
            class="leading-5 md:w-75 md:text-xl md:leading-6 lg:w-100 lg:text-2xl lg:leading-7"
          >
            Persona 3 Dual is a ground-up, open-source demake that reimagines
            the beloved RPG for classic dual-screen hardware. Step back into
            2009, and master the Dark Hour, climb Tartarus, and live your high
            school life all over again.
          </p>
        </div>

        <div class="flex flex-col gap-2 md:w-75 lg:w-100">
          <Button className="md:text-xl lg:p-6! lg:text-2xl"
            >Download Now!</Button
          >
          <p class="text-center text-[10px] uppercase">
            This project is not for profit and not affiliated with SEGA, ATLUS,
            or Nintendo.
          </p>
        </div>
      </div>
    </section>

    <div class="md:water-bg">
      <div class="max-md:water-bg">
        <section
          id="showcase"
          class="p3d-container flex flex-col gap-4 py-10 text-white md:flex-row md:items-center md:gap-15 md:py-20"
        >
          <div class="flex flex-col gap-2 md:basis-1/2 lg:gap-4">
            <h2
              class="font-noto-sans text-center text-xl font-extrabold md:text-left md:text-2xl lg:text-3xl"
            >
              A fan favourite story, now on dual screens
            </h2>
            <p
              class="text-center leading-5 md:text-left md:text-lg md:leading-6 lg:text-xl"
            >
              Take your favourite members of SEES with you wherever you go.
              Whether you're hanging out at Paulownia Mall or strategizing your
              next big fight in the control centre, the split-screen layout
              makes managing your team, checking the calendar, and organizing
              your Personas easier and more charming than ever.
            </p>
          </div>

          <div
            class="@container relative mx-auto my-10 aspect-385/288 w-full max-w-125 shrink-0 md:max-w-none md:flex-0 md:grow md:basis-1/2"
          >
            <img
              src={showcase1Image}
              class="border-primary absolute right-0 h-auto w-[60cqi] border-6"
            />

            <img
              src={showcase2Image}
              class="border-primary absolute left-0 h-auto w-[60cqi] translate-y-[25cqi] border-6"
            />

            <img
              src={showcase3Image}
              class="border-primary absolute right-0 h-auto w-[50cqi] translate-x-[-3cqi] translate-y-[40cqi] border-6"
            />
          </div>
        </section>

        <section
          id="milestone-video"
          class="p3d-container flex flex-col gap-4 pt-10 text-white"
        >
          <div class="flex flex-col gap-2">
            <h2 class="font-noto-sans text-center text-xl font-extrabold">
              Milestone #1: Game Concept
            </h2>
            <p class="text-center">Check out our latest release!</p>
          </div>
        </section>
      </div>

      <section
        id="social-media"
        class="max-md:water-bg py-10 text-white md:py-20"
      >
        <div
          class="p3d-container flex flex-col gap-4 text-white md:flex-row-reverse md:items-center md:gap-15"
        >
          <div class="flex flex-col gap-2 md:basis-1/2 lg:gap-4">
            <h2
              class="font-noto-sans text-center text-xl font-extrabold md:text-left md:text-2xl lg:text-3xl"
            >
              Keep Updated
            </h2>
            <p
              class="text-center leading-5 md:text-left md:text-lg md:leading-6 lg:text-xl"
            >
              Want to see how Tatsumi Port Island is coming to life? Catch our
              latest progress, tutorials, and music drops across all our
              channels. Want to have an inside look at development? Join the
              conversation on Discord to watch our major development updates!
            </p>
          </div>

          <!-- TODO: add floating animation on each card -->
          <!-- TODO: fill with real social links -->

          <div
            class="@container relative mx-auto my-10 aspect-385/365 w-full max-w-125 shrink-0 md:max-w-none md:flex-0 md:grow md:basis-1/2"
          >
            <a
              href="https://example.com"
              class="absolute left-0 w-fit translate-y-[15cqi] -rotate-8"
            >
              <img
                src={tiktokCard}
                alt="Tiktok social media card"
                class="h-auto w-[28cqi]"
              />
            </a>

            <a
              href="https://example.com"
              class="absolute left-[50%] w-fit translate-x-[-50%]"
            >
              <img
                src={xCard}
                alt="X social media card"
                class="h-auto w-[28cqi]"
              />
            </a>

            <a
              href="https://example.com"
              class="absolute right-0 w-fit translate-y-[15cqi] rotate-8"
            >
              <img
                src={redditCard}
                alt="Reddit social media card"
                class="h-auto w-[28cqi]"
              />
            </a>

            <a
              href="https://example.com"
              class="absolute left-[50%] w-fit translate-x-[-50%] translate-y-[53cqi] -rotate-8"
            >
              <img
                src={instagramCard}
                alt="Instagram social media card"
                class="h-auto w-[28cqi]"
              />
            </a>
          </div>
        </div>
      </section>
    </div>

    <section id="download-cta" class="relative overflow-hidden py-10">
      <a href="/download" class="block">
        {
          Array.from(Array(6), () => (
            <div class="download-now-text">
              {Array.from(Array(10), () => (
                <DownloadNowText />
              ))}
            </div>
          ))
        }
      </a>

      <p class="text-center text-xs uppercase">
        This project is not for profit and not affiliated with SEGA, ATLUS, or
        Nintendo.
      </p>
    </section>

    <section id="join-the-team" class="py-20">
      <div class="p3d-container flex flex-col gap-2">
        <h2 class="font-noto-sans text-center text-2xl font-extrabold">
          Join the Team!
        </h2>
        <p class="text-center">
          Help contribute to making this project a reality!
        </p>
      </div>
    </section>

    <section
      id="progress"
      class="clock-bg flex flex-col gap-10 py-20 text-white"
    >
      <div class="p3d-container flex flex-col gap-2 lg:gap-4">
        <h2
          class="font-noto-sans text-center text-xl font-extrabold md:text-2xl lg:text-3xl"
        >
          See the Progress
        </h2>
        <p class="text-center leading-5 md:text-lg md:leading-6 lg:text-xl">
          Check out our Roadmap & Current Tasks
        </p>
      </div>

      <div
        class="p3d-container mx-auto flex max-w-162.5 gap-8 *:w-0 *:grow *:basis-0"
      >
        <Button>Roadmap</Button>
        <Button>Project Board</Button>
      </div>

      <ProjectTimeline />
    </section>
  </main>
</Layout>

<style>
  @import "../styles/global.css";

  .dot-bg {
    background-image: url("@assets/dot_pattern.svg");
    background-size: 50px;

    @variant md {
      background-size: 60px;
    }

    @variant xl {
      background-size: unset;
    }
  }

  @utility water-bg {
    background-image: url("@assets/water_bg.webp");
    background-size: cover;
  }

  .clock-bg {
    background-color: rgba(0, 0, 0, 0.4);
    background-blend-mode: multiply;
    background-image: url("@assets/clocks_broken.webp");
    background-size: contain;
    background-position: center center;
    background-repeat: no-repeat repeat;
  }

  .download-now-text {
    display: inline-flex;
    gap: 20px;
    animation-duration: 5s;
    animation-iteration-count: infinite;
    animation-timing-function: linear;

    &:nth-child(odd) {
      animation-name: download-now-scroll;
    }
    &:nth-child(even) {
      animation-name: download-now-scroll-inverse;
    }

    > svg {
      height: calc(50px * var(--scale));
      width: auto;
    }
  }

  @keyframes download-now-scroll {
    from {
      transform: translate3d(-50%, 0, 0);
    }
    to {
      transform: translate3d(calc(-10% - 50%), 0, 0);
    }
  }

  @keyframes download-now-scroll-inverse {
    from {
      transform: translate3d(calc(-10% - 50%), 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
</style>
