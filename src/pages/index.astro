---
import { Image } from "astro:assets";

import Button from "../components/react/Button";
import Layout from "../layouts/Layout.astro";
import HeroDS from "../components/HeroDS.astro";
import ProjectTimeline from "../components/react/ProjectTimeline";

import tiktokCard from "../assets/card_tiktok.webp";
import xCard from "../assets/card_x.webp";
import redditCard from "../assets/card_reddit.webp";
import instagramCard from "../assets/card_instagram.webp";

import DownloadNowText from "../assets/download_now.svg";
---

<Layout>
  <main class="pt-15">
    <section id="hero" class="relative">
      <!-- TODO: missing the dots background -->
      <HeroDS class="absolute top-0 right-0 h-full w-auto text-[#79CEFF]" />

      <div class="p3d-container relative flex flex-col gap-4 py-10">
        <div class="flex flex-col gap-10">
          <h1 class="font-bmspace text-2xl">
            Introducing Persona 3 <span class="text-secondary">Dual</span>
          </h1>
          <p class="leading-5">
            Persona 3 Dual is a ground-up, open-source demake that reimagines
            the beloved RPG for classic dual-screen hardware. Step back into
            2009, and master the Dark Hour, climb Tartarus, and live your high
            school life all over again.
          </p>
        </div>

        <div class="flex flex-col gap-2">
          <Button>Download Now!</Button>
          <p class="text-center text-[10px] uppercase">
            This project is not for profit and not affiliated with SEGA, ATLUS,
            or Nintendo.
          </p>
        </div>
      </div>
    </section>

    <div class="water-bg">
      <section
        id="showcase"
        class="p3d-container flex flex-col gap-4 py-10 text-white"
      >
        <div class="flex flex-col gap-2">
          <h2 class="font-noto-sans text-center font-extrabold">
            A fan favourite story, now on dual screens
          </h2>
          <p class="text-center">
            Take your favourite members of SEES with you wherever you go.
            Whether you're hanging out at Paulownia Mall or strategizing your
            next big fight in the control centre, the split-screen layout makes
            managing your team, checking the calendar, and organizing your
            Personas easier and more charming than ever.
          </p>
        </div>
      </section>

      <section
        id="milestone-video"
        class="p3d-container flex flex-col gap-4 pt-10 text-white"
      >
        <div class="flex flex-col gap-2">
          <h2 class="font-noto-sans text-center text-xl font-extrabold">
            Milestone #1: Game Concept
          </h2>
          <p class="text-center">Check out our latest release!</p>
        </div>
      </section>
    </div>

    <section
      id="social-media"
      class="water-bg flex flex-col gap-4 py-20 text-white"
    >
      <div class="p3d-container flex flex-col gap-2">
        <h2 class="font-noto-sans text-center text-xl font-extrabold">
          Keep Updated
        </h2>
        <p class="text-center">
          Follow the project on our social media. Make sure to share!
        </p>

        <!-- TODO: add floating animation on each card -->
        <!-- TODO: fill with real social links -->
        <div class="flex items-center justify-center">
          <div
            class="@container relative aspect-385/400 w-full max-w-125 shrink grow-0 py-10"
          >
            <!-- <a
            href="https://example.com"
            class="absolute left-0 w-fit translate-y-15 -rotate-8"
          >
            <Image
              src={tiktokCard}
              alt="Tiktok social media card"
              class="h-37.5 w-auto"
            />
          </a> -->

            <a
              href="https://example.com"
              class="absolute left-0 w-fit translate-y-[15cqi] -rotate-8"
            >
              <Image
                src={tiktokCard}
                alt="Tiktok social media card"
                class="h-auto w-[28cqi]"
              />
            </a>

            <a
              href="https://example.com"
              class="absolute left-[50%] w-fit translate-x-[-50%]"
            >
              <Image
                src={xCard}
                alt="X social media card"
                class="h-auto w-[28cqi]"
              />
            </a>

            <a
              href="https://example.com"
              class="absolute right-0 w-fit translate-y-[15cqi] rotate-8"
            >
              <Image
                src={redditCard}
                alt="Reddit social media card"
                class="h-auto w-[28cqi]"
              />
            </a>

            <a
              href="https://example.com"
              class="absolute left-[50%] w-fit translate-x-[-50%] translate-y-[53cqi] -rotate-8"
            >
              <Image
                src={instagramCard}
                alt="Instagram social media card"
                class="h-auto w-[28cqi]"
              />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="download-cta" class="relative overflow-hidden py-10">
      <a href="/download" class="block">
        {
          Array.from(Array(6), () => (
            <div class="download-now-text">
              {Array.from(Array(10), () => (
                <DownloadNowText />
              ))}
            </div>
          ))
        }
      </a>

      <p class="text-center text-xs uppercase">
        This project is not for profit and not affiliated with SEGA, ATLUS, or
        Nintendo.
      </p>
    </section>

    <section id="join-the-team" class="py-20">
      <div class="p3d-container flex flex-col gap-2">
        <h2 class="font-noto-sans text-center text-2xl font-extrabold">
          Join the Team!
        </h2>
        <p class="text-center">
          Help contribute to making this project a reality!
        </p>
      </div>
    </section>

    <section
      id="progress"
      class="clock-bg flex flex-col gap-10 py-20 text-white"
    >
      <div class="p3d-container flex flex-col gap-2">
        <h2 class="font-noto-sans text-center text-xl font-extrabold">
          See the Progress
        </h2>
        <p class="text-center">Check out our Roadmap & Current Tasks</p>
      </div>

      <div class="p3d-container flex gap-8 *:w-0 *:grow *:basis-0">
        <Button>Roadmap</Button>
        <Button>Project Board</Button>
      </div>

      <ProjectTimeline />
    </section>
  </main>
</Layout>

<style>
  .water-bg {
    background-image: url("@assets/water-bg.webp");
    background-size: cover;
  }

  .clock-bg {
    background-color: rgba(0, 0, 0, 0.4);
    background-blend-mode: multiply;
    background-image: url("@assets/clocks_broken.webp");
    background-size: contain;
    background-position: center center;
    background-repeat: no-repeat repeat;
  }

  .download-now-text {
    display: inline-flex;
    gap: 20px;
    animation-duration: 5s;
    animation-iteration-count: infinite;
    animation-timing-function: linear;

    &:nth-child(odd) {
      animation-name: download-now-scroll;
    }
    &:nth-child(even) {
      animation-name: download-now-scroll-inverse;
    }

    > svg {
      height: calc(50px * var(--scale));
      width: auto;
    }
  }

  @keyframes download-now-scroll {
    from {
      transform: translate3d(-50%, 0, 0);
    }
    to {
      transform: translate3d(calc(-10% - 50%), 0, 0);
    }
  }

  @keyframes download-now-scroll-inverse {
    from {
      transform: translate3d(calc(-10% - 50%), 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
</style>
